# Cloudflare Pages header rules.
#
# The photographs and the noise texture are content-addressed by build: they
# only change when the corpus is rebuilt, so they can be cached hard. The
# entry point must not be, or a deploy would not be visible until caches expire.

# A visit draws a random subset of the corpus, so the cache fills in over
# repeated visits rather than all at once. That only pays off if these never
# revalidate -- which is what makes the wall get faster the more it is used.
/photos/*
  Cache-Control: public, max-age=31536000, immutable

/depth/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Cache-Control: public, max-age=31536000, immutable

/bluenoise.png
  Cache-Control: public, max-age=31536000, immutable

/preview.jpg
  Cache-Control: public, max-age=86400

/*.js
  Cache-Control: public, max-age=600

/manifest.json
  Cache-Control: public, max-age=600

/
  Cache-Control: public, max-age=60
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
